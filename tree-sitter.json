{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "scss",
      "camelcase": "SCSS",
      "title": "Scss",
      "scope": "source.scss",
      "file-types": [
        "scss"
      ],
      "injection-regex": "^scss$",
      "class-name": "TreeSitterScss"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "SCSS grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-scss",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}